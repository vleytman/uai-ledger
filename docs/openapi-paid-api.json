              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "provider_account_id",
          "subscription_id",
          "reason"
        ],
        "additionalProperties": false
