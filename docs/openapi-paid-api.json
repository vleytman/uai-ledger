  "components": {
    "securitySchemes": {
      "ServiceToken": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Receipt": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.:-]{1,200}$"
          },
          "revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "revision"
        ],
        "additionalProperties": false
      },
      "Conflict": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "Quantity": {
        "type": "string",
        "pattern": "^(0|[1-9]\\d{0,28})(\\.\\d{1,9})?$"
      },
      "Units": {
        "type": "string",
        "pattern": "^(0|[1-9]\\d{0,18})$"
      },
      "ServiceOperation": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.:-]{1,200}$"
          },
          "kind": {
            "type": "string",
            "const": "api"
          },
          "capability": {
            "type": "string",
            "const": "api.call"
          },
          "provider": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.:-]{1,200}$"
          },
          "adapter_ref": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.-]+@[1-9]\\d*$"
          },
          "input_schema": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "output_schema": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "files": {
            "type": "object",
            "properties": {
              "media_types": {
                "maxItems": 30,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "max_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "max_file_bytes": {
                "type": "string",
                "pattern": "^(0|[1-9]\\d{0,18})$"
              },
              "max_total_bytes": {
                "type": "string",
                "pattern": "^(0|[1-9]\\d{0,18})$"
              }
            },
            "required": [
              "media_types",
              "max_count",
              "max_file_bytes",
              "max_total_bytes"
            ],
            "additionalProperties": false
          },
          "billing_mode": {
            "type": "string",
            "enum": [
              "quoted_final",
              "actual_capped"
            ]
          },
          "allowance_mode": {
            "type": "string",
            "enum": [
              "subscription",
              "unmetered"
            ]
          },
          "measurements": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_.:-]{1,200}$"
                },
                "unit": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_.:-]{1,200}$"
                },
                "source": {
                  "type": "string",
                  "enum": [
                    "request",
                    "verified_assets",
                    "provider_usage"
                  ]
                },
                "maximum": {
                  "type": "string",
                  "pattern": "^(0|[1-9]\\d{0,28})(\\.\\d{1,9})?$"
                },
                "expression": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "required": [
                "key",
                "unit",
                "source",
                "maximum"
              ],
              "additionalProperties": false
            }
          },
          "pricing": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "const": "independent"
                  },
                  "expression": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  },
                  "max_units": {
                    "type": "string",
                    "pattern": "^(0|[1-9]\\d{0,18})$"
                  },
                  "rounding_units": {
                    "type": "string",
                    "pattern": "^(0|[1-9]\\d{0,18})$"
                  }
                },
                "required": [
                  "mode",
                  "expression",
                  "max_units",
                  "rounding_units"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "const": "cost_plus"
                  },
                  "markup_percent": {
                    "type": "string",
                    "pattern": "^(0|[1-9]\\d{0,28})(\\.\\d{1,9})?$"
                  },
                  "safety_factor": {
                    "type": "string",
                    "pattern": "^(0|[1-9]\\d{0,28})(\\.\\d{1,9})?$"
                  },
                  "max_units": {
                    "type": "string",
                    "pattern": "^(0|[1-9]\\d{0,18})$"
                  },
                  "rounding_units": {
                    "type": "string",
                    "pattern": "^(0|[1-9]\\d{0,18})$"
                  }
                },
                "required": [
                  "mode",
                  "markup_percent",
                  "safety_factor",
                  "max_units",
                  "rounding_units"
                ],
                "additionalProperties": false
              }
            ]
          },
          "samples": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "input": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "assets": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 16
                    },
                    "bytes": {
                      "type": "string",
                      "pattern": "^(0|[1-9]\\d{0,18})$"
                    }
                  },
                  "required": [
                    "count",
                    "bytes"
                  ],
                  "additionalProperties": false
                },
                "measurements": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_.:-]{1,200}$"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^(0|[1-9]\\d{0,28})(\\.\\d{1,9})?$"
                  }
                },
                "expected_price_units": {
                  "type": "string",
                  "pattern": "^(0|[1-9]\\d{0,18})$"
                }
              },
              "required": [
                "name",
                "input",
                "assets",
                "measurements",
                "expected_price_units"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "key",
          "kind",
          "capability",
          "provider",
          "adapter_ref",
          "input_schema",
          "output_schema",
          "files",
          "billing_mode",
          "allowance_mode",
          "measurements",
          "pricing",
          "samples"
        ],
        "additionalProperties": false
      },
      "TariffTemplate": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.:-]{1,200}$"
          },
          "provider": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.:-]{1,200}$"
          },
          "calendar": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "calendar_month",
                  "anniversary_month"
                ]
              },
              "timezone": {
                "type": "string",
                "minLength": 1
              },
              "anchor": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              }
            },
            "required": [
              "kind",
              "timezone",
              "anchor"
            ],
            "additionalProperties": false
          },
          "counters": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_.:-]{1,200}$"
                },
                "unit": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_.:-]{1,200}$"
                },
                "dimensions": {
                  "minItems": 1,
                  "maxItems": 30,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_.:-]{1,200}$"
                  }
                },
                "included": {
                  "type": "string",
                  "pattern": "^(0|[1-9]\\d{0,28})(\\.\\d{1,9})?$"
                },
                "rollover": {
                  "type": "object",
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "cap": {
                      "type": "string",
                      "pattern": "^(0|[1-9]\\d{0,28})(\\.\\d{1,9})?$"
                    },
                    "expires_after_periods": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 24
                    }
                  },
                  "required": [
                    "enabled",
                    "cap",
                    "expires_after_periods"
                  ],
                  "additionalProperties": false
                },
                "overage_usd_per_unit": {
                  "type": "string",
                  "pattern": "^(0|[1-9]\\d{0,28})(\\.\\d{1,9})?$"
                }
              },
              "required": [
                "key",
                "unit",
                "included",
                "rollover"
              ],
              "additionalProperties": false
            }
          },
          "overage": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "max_units": {
                "type": "string",
                "pattern": "^(0|[1-9]\\d{0,18})$"
              }
            },
            "required": [
              "enabled",
              "max_units"
            ],
            "additionalProperties": false
          },
          "cost_allocation": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "const": "incremental"
                  }
                },
                "required": [
                  "mode"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "const": "allocated"
                  },
                  "subscription_fee_units": {
                    "type": "string",
                    "pattern": "^(0|[1-9]\\d{0,18})$"
                  },
                  "allocation_rates": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9_.:-]{1,200}$"
                    },
                    "additionalProperties": {
                      "type": "string",
                      "pattern": "^(0|[1-9]\\d{0,28})(\\.\\d{1,9})?$"
                    }
                  }
                },
                "required": [
                  "mode",
                  "subscription_fee_units",
                  "allocation_rates"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "key",
          "provider",
          "calendar",
          "counters",
          "overage",
          "cost_allocation"
        ],
        "additionalProperties": false
      },
      "SubscriptionCreate": {
        "type": "object",
        "properties": {
          "provider_account_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.:-]{1,200}$"
          },
          "tariff_version_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.:-]{1,200}$"
          },
          "starts_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "installation_share": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.:-]{1,200}$"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^(0|[1-9]\\d{0,28})(\\.\\d{1,9})?$"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "provider_account_id",
          "tariff_version_id",
          "starts_at",
          "installation_share",
          "reason"
        ],
        "additionalProperties": false
      },
      "ProviderAccountCreate": {
        "type": "object",
