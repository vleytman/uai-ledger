ARG NODE_IMAGE=node:22-bookworm-slim
FROM ${NODE_IMAGE}
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY packages ./packages
COPY apps/api ./apps/api
COPY apps/worker ./apps/worker
COPY apps/scheduler ./apps/scheduler
COPY scripts/migrate.ts ./scripts/migrate.ts
COPY scripts/transition-request-backend.ts ./scripts/transition-request-backend.ts
COPY scripts/setup-quota-templates.ts ./scripts/setup-quota-templates.ts
COPY migrations ./migrations
COPY docs/openapi.json ./docs/openapi.json
RUN pnpm install --frozen-lockfile --filter uai
ENV NODE_ENV=production UAI_HOST=0.0.0.0 UAI_PORT=4310
USER node
EXPOSE 4310
CMD ["node", "--import", "tsx", "apps/api/src/index.ts"]
