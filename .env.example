DATABASE_URL=postgresql://uai:uai_local_only@127.0.0.1:55432/uai
UAI_ENV=test
UAI_HOST=127.0.0.1
UAI_PORT=4310
UAI_BLOB_ROOT=.data/blobs
UAI_DEMO_ROOT=.data/demo
# Real provider requests stay disabled until credentials and budget are authorized.
UAI_ALLOW_REAL_PROVIDERS=false
UAI_VAULT_KEY_FILE=.data/vault-key
UAI_ENABLE_WEBHOOK_DELIVERY=false
UAI_ALLOW_REPORTING_API=false
# Each process owns one pool. Total budget = replicas × their role maximum.
UAI_DB_POOL_MAX_API=10
UAI_DB_POOL_MAX_WORKER=8
UAI_DB_POOL_MAX_SCHEDULER=4
UAI_DB_CONNECT_TIMEOUT_MS=5000
UAI_DB_IDLE_TIMEOUT_MS=30000
UAI_REDIS_COMMAND_TIMEOUT_MS=2000

# Shared blob storage: local for a single host, s3 for multiple hosts.
UAI_BLOB_BACKEND=local
# UAI_S3_BUCKET=uai-private
# UAI_S3_REGION=us-east-1
# UAI_S3_PREFIX=installation-name
# UAI_S3_ENDPOINT=https://s3.example.com
# UAI_S3_FORCE_PATH_STYLE=false
# A hung endpoint fails with blob_store_timeout instead of blocking callers.
# UAI_S3_CONNECT_TIMEOUT_MS=2000
# UAI_S3_SOCKET_TIMEOUT_MS=10000
# UAI_S3_OPERATION_TIMEOUT_MS=30000
# UAI_S3_MAX_ATTEMPTS=3
# Supply UAI_S3_ACCESS_KEY_ID and UAI_S3_SECRET_ACCESS_KEY via secrets,
# or use the AWS SDK credential chain / workload identity.
# SIGINT/SIGTERM grace, including provider calls and connection cleanup.
UAI_WORKER_SHUTDOWN_GRACE_MS=30000
