{
  "name": "uai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "typecheck": "tsc --noEmit && pnpm --filter @uai/admin typecheck && pnpm --filter @uai/demo typecheck",
    "test": "vitest run",
    "test:redis-restart": "UAI_TEST_REDIS_RESTART=1 vitest run packages/queue/test/redis-restart.test.ts packages/queue/test/redis-delivery-restart.test.ts",
    "test:load": "tsx scripts/load-distributed.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "docs:check": "tsx scripts/check-docs.ts",
    "build": "pnpm --filter @uai/admin build && pnpm --filter @uai/demo build",
    "seed": "tsx scripts/seed.ts",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:worker": "tsx watch apps/worker/src/index.ts",
    "dev:scheduler": "tsx watch apps/scheduler/src/index.ts",
    "dev:admin": "pnpm --filter @uai/admin dev",
    "dev:demo": "pnpm --filter @uai/demo dev",
    "generate:api": "tsx scripts/generate-openapi.ts",
    "check:api": "tsx scripts/generate-openapi.ts --check",
    "test:postgres-outage": "UAI_TEST_POSTGRES_OUTAGE=1 vitest run packages/queue/test/postgres-outage.test.ts",
    "test:containers": "docker build -f Dockerfile.runtime -t uai-runtime:distributed-test . && UAI_TEST_CONTAINERS=1 vitest run packages/queue/test/container-runtime.test.ts",
    "configuration": "tsx scripts/configuration.ts",
    "generate:configuration": "tsx scripts/generate-configuration-schema.ts",
    "check:configuration": "tsx scripts/generate-configuration-schema.ts --check",
    "generate:paid-api": "tsx scripts/generate-paid-api.ts",
    "check:paid-api": "tsx scripts/generate-paid-api.ts --check"
  },
  "dependencies": {
    "@audio/decode-wav": "1.5.0",
    "@aws-sdk/client-s3": "3.1136.0",
    "@fastify/cookie": "11",
    "@fastify/swagger": "9",
    "bullmq": "5.81.5",
    "drizzle-orm": "^0.44.5",
    "fast-xml-parser": "^5.11.1",
    "fastify": "5",
    "google-auth-library": "10.3.0",
    "ioredis": "5.11.1",
    "js-tiktoken": "1.0.21",
    "mpg123-decoder": "1.0.3",
    "pg": "^8.16.3",
    "sharp": "^0.35.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
