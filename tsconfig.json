{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@uai/contracts": [
        "packages/contracts/src/index.ts"
      ],
      "@uai/db": [
        "packages/db/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "apps/api/**/*.ts",
    "apps/worker/**/*.ts",
    "apps/scheduler/**/*.ts"
  ]
}
